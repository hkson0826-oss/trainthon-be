# Lumina 주차장 사고 증거 매칭 데모 — 환경 변수 예시
#
# 사용법
#   BE: 이 파일을 server/.env 로 복사해 FILL 표시 값을 채운다.
#   FE: NEXT_PUBLIC_* 값만 FE 저장소의 .env.local 로 옮긴다.
#   .env / .env.local 은 커밋하지 않는다. 비밀 값은 이 파일에 절대 적지 않는다.
#
# 규칙
#   - Firebase는 사용하지 않는다. Auth / DB / Storage는 모두 Supabase.
#   - SUPABASE_SERVICE_ROLE_KEY, TWELVELABS_API_KEY 는 서버 전용. NEXT_PUBLIC_ 로 노출 금지.
#   - 브라우저는 TwelveLabs 등 AI 공급자 API를 직접 호출하지 않는다.


# ─────────────────────────────────────────────
# 1. 서버 기본 (BE)
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_PER_MINUTE=60


# ─────────────────────────────────────────────
# 2. 데모 모드 (BE)
# ─────────────────────────────────────────────
# true 이면 /api/v1/demo/* 라우트 등록, 발표자(X 계정)의 보험사 채택 버튼 허용
DEMO_MODE=true
# FILL: POST /demo/reset 호출 시 X-Demo-Admin-Token 헤더와 비교할 임의 문자열
DEMO_ADMIN_TOKEN=
# seed 방문 이력의 날짜. 비우면 seed 실행 당일(Asia/Seoul). 형식 YYYY-MM-DD
DEMO_DATE=
DEMO_TIMEZONE=Asia/Seoul
# 데모 계정 (MOCK_DATA_AND_ASSETS.md §2). 비밀번호는 FE의 NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD 와 같은 값
DEMO_REQUESTER_EMAIL=demo.requester@lumina.local
DEMO_WITNESS_EMAIL=demo.witness@lumina.local
DEMO_OPERATOR_EMAIL=demo.operator@lumina.local
# FILL
DEMO_ACCOUNT_PASSWORD=


# ─────────────────────────────────────────────
# 3. Supabase (BE, 서버 전용)
# ─────────────────────────────────────────────
# FILL: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=
# FILL: Project Settings → API → service_role (서버 전용, 절대 FE에 넣지 않음)
SUPABASE_SERVICE_ROLE_KEY=
# 선택: JWKS 대신 JWT secret 으로 검증할 때만. 기본은 auth.getUser(jwt) / JWKS
SUPABASE_JWT_SECRET=
# Storage 버킷 이름 (private)
SUPABASE_BUCKET_PHOTOS=incident-photos
SUPABASE_BUCKET_VIDEOS=evidence-videos
# signed URL 유효 시간(초)
UPLOAD_SIGNED_URL_TTL_SEC=600
VIDEO_SIGNED_URL_TTL_SEC=900
PHOTO_SIGNED_URL_TTL_SEC=900


# ─────────────────────────────────────────────
# 4. 업로드 제한 (BE)
# ─────────────────────────────────────────────
MAX_PHOTO_BYTES=10485760
MAX_PHOTO_COUNT=2
MAX_VIDEO_BYTES=209715200
MIN_VIDEO_SECONDS=4
MAX_VIDEO_SECONDS=3600
# ffprobe 로 duration/해상도 검증할지 (서버에 ffmpeg 설치 필요). false 면 클라이언트 값 + Storage 메타만 사용
VIDEO_PROBE_ENABLED=false
FFPROBE_PATH=ffprobe


# ─────────────────────────────────────────────
# 5. 매칭·알림 (BE)
# ─────────────────────────────────────────────
# 방문 이력과 사고 시간대 겹침 판정 시 앞뒤 여유(분)
MATCH_TIME_PADDING_MIN=15
# 방문 기록 보관 기간(일)
VISIT_RETENTION_DAYS=30


# ─────────────────────────────────────────────
# 6. AI 분석 에이전트 — TwelveLabs (BE, 서버 전용)
# ─────────────────────────────────────────────
# live: 실제 TwelveLabs 호출(기본). 키가 없으면 서버 시작 실패. fake 는 로컬 테스트 전용(고정 fixture 반환, 화면에 source=PRERECORDED 표기)
AI_MODE=live
AI_PROVIDER=twelvelabs
# FILL: https://playground.twelvelabs.io → API Keys
TWELVELABS_API_KEY=
TWELVELABS_BASE_URL=https://api.twelvelabs.io/v1.3
TWELVELABS_MODEL=pegasus1.5
# 프롬프트/스키마 버전 (BE_SPEC F6). 스키마 수정 시 올린다
ANALYSIS_PROMPT_VERSION=v1
ANALYSIS_TEMPERATURE=0.2
ANALYSIS_MAX_TOKENS=1024
# 영상 전달 방식: url(signed URL, 기본) | base64. url 실패 시 base64 로 1회 재시도
TWELVELABS_VIDEO_SOURCE=url
# base64 전달 허용 상한(바이트). TwelveLabs 상한 30MB 보다 작게
TWELVELABS_BASE64_MAX_BYTES=26214400
# X 피해 차량 사진을 prompt_v2.media_sources 참고 이미지로 전달할지 (최대 4장)
ANALYSIS_USE_REFERENCE_IMAGES=true
ANALYSIS_TIMEOUT_MS=120000
ANALYSIS_MAX_ATTEMPTS=2
ANALYSIS_QUEUE_CONCURRENCY=1
# 공급자 장애(PROVIDER_UNAVAILABLE/TIMEOUT) 시에만 sha256 일치 fixture 를 source=PRERECORDED 로 사용
PRERECORDED_FALLBACK_ENABLED=true
PRERECORDED_FIXTURES_DIR=./fixtures/prerecorded


# ─────────────────────────────────────────────
# 7. 보험사 채택·에스크로 Mock (BE)
# ─────────────────────────────────────────────
DEMO_DEPOSIT_AMOUNT=100000
DEMO_PLATFORM_FEE=20000
DISPUTE_WINDOW_HOURS=72


# ─────────────────────────────────────────────
# 8. 프론트엔드 (FE 저장소 .env.local 로 이동, public 값만)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# FILL: Supabase Project URL (SUPABASE_URL 과 같은 값)
NEXT_PUBLIC_SUPABASE_URL=
# FILL: Project Settings → API → anon / publishable key (service_role 금지)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kakao provider 를 Supabase + Kakao Developers 에 설정한 뒤에만 true
NEXT_PUBLIC_KAKAO_AUTH_ENABLED=false
# 데모 계정 전환 스위치 표시
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_REQUESTER_EMAIL=demo.requester@lumina.local
NEXT_PUBLIC_DEMO_WITNESS_EMAIL=demo.witness@lumina.local
# FILL: DEMO_ACCOUNT_PASSWORD 와 같은 값 (데모 전용 계정, 운영 환경에서는 비움)
NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD=
# 분석 폴링 상한(ms)
NEXT_PUBLIC_ANALYSIS_POLL_TIMEOUT_MS=180000


# ─────────────────────────────────────────────
# 9. Kakao 로그인 (선택, Supabase Dashboard 에서 설정. 서버 env 에는 두지 않음)
# ─────────────────────────────────────────────
# Supabase → Authentication → Providers → Kakao 에 입력:
#   Client ID     = Kakao Developers REST API 키
#   Client Secret = Kakao Login Client Secret
# Kakao Developers Redirect URI = https://<PROJECT_REF>.supabase.co/auth/v1/callback
# Supabase → URL Configuration → Redirect URLs 에 http://localhost:3000/auth/callback 추가
