# Copy this file to .env and fill in the values marked FILL.
# Do not commit .env.

NODE_ENV=development
PORT=3001
APP_MODE=demo
AUTH_MODE=supabase
AI_MODE=live
ADS_MODE=demo

DATABASE_PATH=./data/trainthon.sqlite
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
ADS_SESSION_TTL_SECONDS=600

# FILL: Supabase Settings → API → Project URL
SUPABASE_URL=

# FILL: Supabase Settings → API → service_role (server only, never VITE_)
SUPABASE_SERVICE_ROLE_KEY=

# FILL: https://console.groq.com → API Keys
GROQ_API_KEY=

AI_MODEL=qwen/qwen3.6-27b

# Frontend lives in the FE repo. Put only these public values there:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
